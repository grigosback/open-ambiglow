[Unit]
Description=Ambiglow bridge (HyperHDR udpraw -> Philips Evnia LEDs)
Documentation=https://github.com/grigosback/open-ambiglow
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/Work/github/open-ambiglow/hyperhdr-bridge.py --restore-on-exit --quiet
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
