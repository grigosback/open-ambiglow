# Philips Evnia Ambiglow - ENE 6K7732 MCU inside the monitor
#
# uaccess covers the active seat session on many setups, but logind does not
# always tag devices behind a hub, so a group is the dependable fallback:
#
#   sudo groupadd -r ambiglow && sudo usermod -aG ambiglow "$USER"
#
# then log out and back in.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0cf2", ATTRS{idProduct}=="a201", TAG+="uaccess", MODE="0660", GROUP="ambiglow"
